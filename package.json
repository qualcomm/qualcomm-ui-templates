{
  "name": "qui-templates",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check-all": "ncu -c 1 --deep --reject typescript --reject eslint --reject @eslint/js",
    "update-all": "ncu -c 1 --deep -u --reject typescript --reject eslint --reject @eslint/js",
    "check-qui": "ncu --deep --filter '@qualcomm-ui/*'",
    "update-qui": "ncu --deep --filter '@qualcomm-ui/*' -u",
    "lint-dependencies": "syncpack lint --source 'templates/*/package.json' --source 'templates/*/packages/*/package.json'",
    "fix-dependencies": "syncpack fix --source 'templates/*/package.json' --source 'templates/*/packages/*/package.json'"
  },
  "devDependencies": {
    "npm-check-updates": "23.0.2",
    "syncpack": "15.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.22.0"
}
