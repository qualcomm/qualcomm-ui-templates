{
  "name": "qui-templates",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "check-all": "ncu -c 1 --deep",
    "update-all": "ncu -c 1 --deep -u",
    "check-qui": "ncu --deep --filter '@qualcomm-ui/*'",
    "update-qui": "ncu --deep --filter '@qualcomm-ui/*' -u",
    "lint-dependencies": "syncpack lint --source 'templates/*/package.json' --source 'templates/*/packages/*/package.json'",
    "fix-dependencies": "syncpack fix --source 'templates/*/package.json' --source 'templates/*/packages/*/package.json'"
  },
  "devDependencies": {
    "npm-check-updates": "22.2.1",
    "syncpack": "15.3.1",
    "typescript": "6.0.2"
  },
  "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
