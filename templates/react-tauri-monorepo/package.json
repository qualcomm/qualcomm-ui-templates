{
  "name": "@qui/react-tauri-vite-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "tauri dev",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint --continue",
    "lint:cache": "eslint --quiet --cache",
    "test": "turbo run test --env-mode=loose",
    "test:ci": "turbo run test:ci --env-mode=loose",
    "update-qui": "ncu --deep --filter '@qualcomm-ui/*' -u",
    "react-app": "pnpm -C packages/react-app",
    "update-dependencies": "ncu --cooldown 1d --target minor --deep -u"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@qualcomm-ui/eslint-config-mdx": "^4.0.0",
    "@qualcomm-ui/eslint-config-react": "^2.0.0",
    "@qualcomm-ui/eslint-config-typescript": "^4.0.0",
    "@qualcomm-ui/eslint-plugin-react": "^1.2.3",
    "@qualcomm-ui/oxfmt-config": "^1.0.1",
    "@qualcomm-ui/tsconfig": "^2.3.0",
    "@qualcomm-ui/utils": "^1.5.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "npm-check-updates": "23.0.2",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.64.0",
    "remark-frontmatter": "5.0.0",
    "remark-lint-fenced-code-flag": "4.2.0",
    "remark-lint-final-newline": "3.0.1",
    "remark-lint-heading-increment": "4.0.1",
    "remark-lint-list-item-content-indent": "4.0.1",
    "remark-lint-list-item-indent": "4.0.1",
    "remark-lint-maximum-heading-length": "4.1.1",
    "remark-lint-no-consecutive-blank-lines": "5.0.1",
    "remark-lint-no-duplicate-headings-in-section": "4.0.1",
    "remark-lint-no-heading-punctuation": "4.0.1",
    "remark-lint-unordered-list-marker-style": "4.0.1",
    "syncpack": "15.3.3",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "packageManager": "pnpm@11.22.0"
}
