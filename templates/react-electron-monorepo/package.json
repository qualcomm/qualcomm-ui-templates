{
  "name": "@qui/react-electron-vite-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "build:ci": "turbo run build",
    "dev": "turbo run dev",
    "dev:ui": "pnpm dev --filter='!@project/electron-app'",
    "dev:electron": "pnpm run -C packages/electron-app dev",
    "package": "turbo run package",
    "lint": "turbo run lint",
    "lint:ci": "turbo run lint --continue",
    "lint:cache": "eslint --quiet --cache",
    "test": "turbo run test --env-mode=loose",
    "test:ci": "turbo run test:ci --env-mode=loose",
    "release": "turbo run make",
    "bundle": "run-s build package",
    "update-qui": "ncu --deep --filter '@qualcomm-ui/*' -u",
    "electron-app": "pnpm -C packages/electron-app",
    "react-app": "pnpm -C packages/react-app",
    "shared-types": "pnpm -C packages/shared-types",
    "update-dependencies": "ncu --cooldown 1d --target minor --deep -u"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@qualcomm-ui/eslint-config-mdx": "^4.0.0",
    "@qualcomm-ui/eslint-config-react": "^2.0.0",
    "@qualcomm-ui/eslint-config-typescript": "^4.0.0",
    "@qualcomm-ui/eslint-plugin-react": "^1.2.3",
    "@qualcomm-ui/oxfmt-config": "^1.0.1",
    "@qualcomm-ui/tsconfig": "^2.3.0",
    "@qualcomm-ui/utils": "^1.5.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "npm-check-updates": "23.0.2",
    "oxfmt": "0.64.0",
    "npm-run-all2": "9.0.3",
    "syncpack": "15.3.3",
    "tailwindcss": "4.3.3",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "packageManager": "pnpm@11.22.0"
}
