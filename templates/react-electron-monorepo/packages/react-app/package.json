{
  "name": "@project/react-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:site": "vite -c vite.config.ts --host --clearScreen=false",
    "dev:ts": "tsc -b tsconfig.lib.json -w --preserveWatchOutput --force",
    "dev": "run-p dev:site dev:ts",
    "build": "tsc -b tsconfig.lib.json --force && vite build",
    "lint": "eslint --quiet",
    "preview": "vite preview -c vite.config.ts",
    "typecheck": "tsc -b tsconfig.lib.json --force"
  },
  "dependencies": {
    "@project/shared-types": "workspace:*",
    "@qualcomm-ui/core": "^1.13.0",
    "@qualcomm-ui/dom": "^1.3.0",
    "@qualcomm-ui/qds-core": "^1.37.0",
    "@qualcomm-ui/react": "^1.30.0",
    "@qualcomm-ui/react-core": "^1.8.0",
    "@qualcomm-ui/tailwind-plugin": "^1.10.0",
    "@qualcomm-ui/utils": "^1.5.0",
    "@tanstack/react-virtual": "3.14.10",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@qualcomm-ui/tsconfig": "^2.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "shx": "0.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
