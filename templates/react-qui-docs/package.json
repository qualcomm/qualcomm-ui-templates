{
  "name": "react-qui-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build-site && pnpm build-semantic-search",
    "build-site": "react-router build",
    "build-semantic-search": "tsx build-semantic-search.ts",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc -b tsconfig.lib.json",
    "lint": "eslint --quiet",
    "update-qui": "ncu --deep --filter '@qualcomm-ui/*' -u && pnpm i && pnpx @qualcomm-ui/codemod@latest migrate qui-docs",
    "update-dependencies": "ncu --cooldown 1d --target minor -u"
  },
  "dependencies": {
    "@qualcomm-ui/core": "^1.14.0",
    "@qualcomm-ui/dom": "^1.3.1",
    "@qualcomm-ui/mdx-common": "^2.7.0",
    "@qualcomm-ui/mdx-vite": "^5.0.0",
    "@qualcomm-ui/qds-core": "^2.0.0",
    "@qualcomm-ui/react": "^2.0.0",
    "@qualcomm-ui/react-core": "^1.10.0",
    "@qualcomm-ui/react-mdx": "^3.3.0",
    "@qualcomm-ui/react-router-utils": "^3.1.1",
    "@qualcomm-ui/tailwind-plugin": "^2.0.0",
    "@qualcomm-ui/utils": "^1.5.0",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.10",
    "isbot": "5.2.1",
    "lucide-react": "1.33.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@mdx-js/react": "3.1.1",
    "@mdx-js/rollup": "3.1.1",
    "@qualcomm-ui/eslint-config-mdx": "^4.0.1",
    "@qualcomm-ui/eslint-config-react": "^2.0.0",
    "@qualcomm-ui/eslint-config-typescript": "^4.0.1",
    "@qualcomm-ui/eslint-plugin-react": "^1.2.3",
    "@qualcomm-ui/oxfmt-config": "^1.0.2",
    "@qualcomm-ui/tsconfig": "^3.0.0",
    "@react-router/dev": "8.5.1",
    "@react-router/remix-routes-option-adapter": "8.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "npm-check-updates": "23.1.1",
    "oxfmt": "0.77.0",
    "remark-frontmatter": "5.0.0",
    "remark-lint-fenced-code-flag": "4.2.0",
    "remark-lint-final-newline": "3.0.1",
    "remark-lint-heading-increment": "4.0.1",
    "remark-lint-list-item-content-indent": "4.0.1",
    "remark-lint-list-item-indent": "4.0.1",
    "remark-lint-maximum-heading-length": "4.1.1",
    "remark-lint-no-consecutive-blank-lines": "5.0.1",
    "remark-lint-no-duplicate-headings-in-section": "4.0.1",
    "remark-lint-no-heading-punctuation": "4.0.1",
    "remark-lint-unordered-list-marker-style": "4.0.1",
    "tailwindcss": "4.3.3",
