{
  "name": "qui-typescript-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist node_modules/.tmp",
    "dev": "run-p watch:js watch:ts",
    "build": "run-s clean build:js build:ts",
    "build:js": "tsx build.ts",
    "build:ts": "tsc -b tsconfig.lib.json",
    "watch:js": "tsx build.ts --watch",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "update-dependencies": "ncu --cooldown 1d --target minor -u"
  },
  "dependencies": {
    "@qualcomm-ui/utils": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@qualcomm-ui/esbuild": "^1.0.7",
    "@qualcomm-ui/eslint-config-typescript": "^4.0.0",
    "@qualcomm-ui/oxfmt-config": "^1.0.1",
    "@qualcomm-ui/tsconfig": "^2.3.0",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "npm-check-updates": "23.0.2",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.64.0",
    "shx": "0.4.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.22.0"
}
