{
  "name": "qui-typescript-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/stub.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist node_modules/.tmp",
    "dev": "run-p watch:js watch:ts",
    "build": "run-s clean build:js build:ts",
    "build:js": "tsx build.ts",
    "build:ts": "tsc -b tsconfig.lib.json",
    "watch:js": "tsx build.ts --watch",
    "watch:ts": "pnpm build:ts -w --preserveWatchOutput",
    "lint": "eslint --quiet",
    "update-dependencies": "ncu --cooldown 1d --target minor -u"
  },
  "dependencies": {
    "@qualcomm-ui/utils": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@qualcomm-ui/esbuild": "^1.0.8",
    "@qualcomm-ui/eslint-config-typescript": "^4.0.1",
    "@qualcomm-ui/oxfmt-config": "^1.0.2",
    "@qualcomm-ui/tsconfig": "^3.0.0",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.11.0",
    "npm-check-updates": "23.1.1",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.77.0",
    "shx": "0.4.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.3.6",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
